# syntax=docker/dockerfile:1.7

# Alpine image, two JRE flavors from one file:
#   docker build -f Dockerfile.alpine .                          -> Eclipse Temurin
#   docker build -f Dockerfile.alpine --build-arg JRE=liberica . -> BellSoft Liberica (smallest)
ARG JRE=temurin

# The image ships no Hypixel file (Hytale EULA §3.3): the official
# hytale-downloader and the server are fetched at first start, with the
# operator's own Hytale account (see scripts/hytale/hytale_downloader.sh).

# STAGE 1: Builder
FROM alpine:3.24 AS builder
RUN apk add --no-cache dos2unix

WORKDIR /build

# Prepare scripts
COPY scripts/ ./scripts/
COPY entrypoint.sh .
RUN find scripts -type f -name "*.sh" -exec dos2unix {} + && \
    dos2unix entrypoint.sh && chmod -R +x scripts && chmod +x entrypoint.sh

# JRE flavors (listed as plain FROM lines so Dependabot keeps bumping them)
FROM eclipse-temurin:25.0.3_9-jre-alpine-3.23 AS runtime-temurin
FROM bellsoft/liberica-openjre-alpine-musl:25.0.3-11 AS runtime-liberica

# STAGE 2: Final Runtime
FROM runtime-${JRE}

# Build arguments for customizable UID/GID
ARG UID=1000
ARG GID=1000

# Build arguments
ARG BUILDTIME=local
ARG VERSION=local
ARG REVISION=local
# Hytale server release this image was built for (set by CI from Hypixel's
# public Maven metadata). The server itself is downloaded at runtime.
ARG HYTALE_TARGET_VERSION=""

# OCI Metadata
LABEL org.opencontainers.image.title="Hytale Server" \
    org.opencontainers.image.description="Hytale server container: downloads the official server at first start. Contains no Hytale files; a Hytale license is required." \
    org.opencontainers.image.authors="deinfreu, Hytale-Assos" \
    org.opencontainers.image.url="https://github.com/Hytale-Assos/hytale-server" \
    org.opencontainers.image.source="https://github.com/Hytale-Assos/hytale-server" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${REVISION}" \
    org.opencontainers.image.created="${BUILDTIME}" \
    org.opencontainers.image.licenses="GPL-3.0-or-later" \
    hytale.server.version="${HYTALE_TARGET_VERSION}"

# Runtime configuration
ENV USER=container \
    HOME=/home/container \
    UID=1000 \
    GID=1000 \
    SCRIPTS_PATH="/usr/local/bin/scripts" \
    SERVER_PORT=5520 \
    SERVER_IP="" \
    JAVA_ARGS="" \
    PROD=FALSE \
    DEBUG=FALSE \
    HYTALE_TARGET_VERSION="${HYTALE_TARGET_VERSION}"

# Install dependencies
RUN apk add --no-cache tini su-exec curl iproute2 ca-certificates tzdata jq libc6-compat libstdc++ gcompat 7zip coreutils

# Install QEMU for x86_64 emulation: Hypixel only ships an x86_64 downloader
ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        echo "[INFO] Detected ARM64, installing QEMU static binary for x86_64 emulation..."; \
        apk add --no-cache qemu-x86_64 && \
        # Verify QEMU is installed and accessible
        which qemu-x86_64-static || which qemu-x86_64 || { echo "ERROR: QEMU not found"; exit 1; }; \
    else \
        echo "[INFO] Detected x86_64, skipping QEMU install (not required)"; \
    fi

# Setup User (with UID/GID conflict handling)
RUN if getent passwd ${UID} > /dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd ${UID} | cut -d: -f1); \
        EXISTING_GROUP=$(getent passwd ${UID} | cut -d: -f4); \
        deluser ${EXISTING_USER} && \
        if getent group ${GID} > /dev/null 2>&1; then \
            GROUP_NAME=$(getent group ${GID} | cut -d: -f1); \
            delgroup ${GROUP_NAME}; \
        fi; \
        addgroup -S -g ${GID} ${USER} && \
        adduser -S -D -h ${HOME} -u ${UID} -G ${USER} ${USER}; \
    else \
        addgroup -S -g ${GID} ${USER} && \
        adduser -S -D -h ${HOME} -u ${UID} -G ${USER} ${USER}; \
    fi

# Ensure home directory exists with proper ownership and permissions before volume definition
RUN mkdir -p ${HOME} && \
    chown -R ${USER}:${USER} ${HOME} && \
    chmod 755 ${HOME}

# Copy artifacts from builder
COPY --from=builder --chown=${USER}:${USER} /build/scripts/ /usr/local/bin/scripts/
COPY --from=builder --chown=${USER}:${USER} /build/entrypoint.sh /entrypoint.sh

# Commands:
#   hytale-downloader  installs Hypixel's downloader on first use, then runs it
#   hytale-cmd         sends a console command: `docker exec <c> hytale-cmd /op add <player>`
RUN ln -s /usr/local/bin/scripts/hytale/hytale_downloader.sh /usr/local/bin/hytale-downloader && \
    ln -s /usr/local/bin/scripts/hytale/hytale_console.sh /usr/local/bin/hytale-cmd

# Image metadata file
RUN printf "buildtime=%s\nversion=%s\nrevision=%s\nhytale_target_version=%s\n" \
        "${BUILDTIME}" "${VERSION}" "${REVISION}" "${HYTALE_TARGET_VERSION}" > /etc/image.properties

# Final setup
WORKDIR ${HOME}

# Declare the volume inside the image metadata to enforce ownership hints
VOLUME [ "/home/container" ]

EXPOSE ${SERVER_PORT}/udp
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=2m --retries=3 CMD ss -ulpn | grep -q ":${SERVER_PORT}" || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/bin/sh", "/entrypoint.sh"]
