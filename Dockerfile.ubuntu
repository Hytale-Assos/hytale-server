# syntax=docker/dockerfile:1.7

# The image ships no Hypixel file (Hytale EULA §3.3): the official
# hytale-downloader and the server are fetched at first start, with the
# operator's own Hytale account (see scripts/hytale/hytale_downloader.sh).

# --- STAGE 1: Builder (runs on target platform) ---
# Same base as the runtime so the layer is shared
FROM eclipse-temurin:25-jre AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    dos2unix && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 1. Prepare Scripts (fixing line endings and permissions)
COPY scripts/ ./scripts/
COPY entrypoint.sh .
RUN find scripts -type f -name "*.sh" -exec dos2unix {} + && \
    dos2unix entrypoint.sh && \
    chmod -R +x scripts && \
    chmod +x entrypoint.sh

# --- STAGE 2: Final Runtime ---
# JRE only: the server never compiles anything at runtime
FROM eclipse-temurin:25-jre AS runtime

# Build arguments for customizable UID/GID
ARG UID=1000
ARG GID=1000

# OCI Metadata
LABEL org.opencontainers.image.title="Hytale Server" \
    org.opencontainers.image.description="Hytale server container: downloads the official server at first start. Contains no Hytale files; a Hytale license is required." \
    org.opencontainers.image.authors="deinfreu, Hytale-Assos" \
    org.opencontainers.image.url="https://github.com/Hytale-Assos/hytale-server" \
    org.opencontainers.image.source="https://github.com/Hytale-Assos/hytale-server" \
    org.opencontainers.image.licenses="GPL-3.0-or-later"

# Configuration
ENV USER=container \
    HOME=/home/container \
    UID=1000 \
    GID=1000 \
    SCRIPTS_PATH="/usr/local/bin/scripts" \
    SERVER_PORT=5520 \
    PROD=FALSE \
    DEBUG=FALSE

# 1. Install Runtime Dependencies (minimal set, no qemu-user-static)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini curl iproute2 ca-certificates unzip tzdata jq p7zip-full && \
    rm -rf /var/lib/apt/lists/*

# 1.1. Install QEMU for x86_64 emulation: Hypixel only ships an x86_64 downloader
ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        echo "[INFO] Detected ARM64, downloading QEMU static binary for x86_64..."; \
        curl -L --retry 3 https://github.com/multiarch/qemu-user-static/releases/download/v7.2.0-1/qemu-x86_64-static.tar.gz -o /tmp/qemu.tar.gz && \
        tar xzf /tmp/qemu.tar.gz -C /usr/local/bin/ && \
        chmod +x /usr/local/bin/qemu-x86_64-static && \
        rm /tmp/qemu.tar.gz && \
        echo "[INFO] QEMU static binary installed successfully"; \
    else \
        echo "[INFO] Detected x86_64, skipping QEMU install (not required)"; \
    fi

# 2. Add Gosu
COPY --from=tianon/gosu:1.19 /gosu /usr/local/bin/

# 3. Setup User (with UID/GID logic)
RUN if getent passwd ${UID} > /dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd ${UID} | cut -d: -f1); \
        EXISTING_GROUP=$(getent passwd ${UID} | cut -d: -f4); \
        if getent group ${GID} > /dev/null 2>&1; then \
            GROUP_NAME=$(getent group ${GID} | cut -d: -f1); \
            groupmod -n ${USER} ${GROUP_NAME}; \
        else \
            groupadd -g ${GID} ${USER}; \
        fi; \
        usermod -l ${USER} -d ${HOME} -m -g ${USER} ${EXISTING_USER}; \
    else \
        groupadd -g ${GID} ${USER} && \
        useradd -m -d ${HOME} -u ${UID} -g ${USER} -s /bin/sh ${USER}; \
    fi

# Ensure home directory exists with proper ownership and permissions before volume definition
RUN mkdir -p ${HOME} && \
    chown -R ${USER}:${USER} ${HOME} && \
    chmod 755 ${HOME}

# 4. Copy Prepared Files from Builder
COPY --from=builder --chown=${USER}:${USER} /build/scripts/ /usr/local/bin/scripts/
COPY --from=builder --chown=${USER}:${USER} /build/entrypoint.sh /entrypoint.sh

# 5. Commands:
#   hytale-downloader  installs Hypixel's downloader on first use, then runs it
#   hytale-cmd         sends a console command: `docker exec <c> hytale-cmd /op add <player>`
RUN ln -s /usr/local/bin/scripts/hytale/hytale_downloader.sh /usr/local/bin/hytale-downloader && \
    ln -s /usr/local/bin/scripts/hytale/hytale_console.sh /usr/local/bin/hytale-cmd

# 6. Build Metadata
ARG BUILDTIME=local
ARG VERSION=local
ARG REVISION=local
# Hytale server release this image was built for (the server is downloaded at runtime)
ARG HYTALE_TARGET_VERSION=""
ENV HYTALE_TARGET_VERSION="${HYTALE_TARGET_VERSION}"
LABEL org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${REVISION}" \
    org.opencontainers.image.created="${BUILDTIME}" \
    hytale.server.version="${HYTALE_TARGET_VERSION}"
RUN printf "buildtime=%s\nversion=%s\nrevision=%s\nhytale_target_version=%s\n" \
        "${BUILDTIME}" "${VERSION}" "${REVISION}" "${HYTALE_TARGET_VERSION}" > /etc/image.properties

# Final Config
WORKDIR ${HOME}

# Declare the volume inside the image metadata to enforce ownership hints for the host mount
VOLUME [ "/home/container" ]

EXPOSE ${SERVER_PORT}/udp
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=2m --retries=3 \
    CMD ss -ulpn | grep -q ":${SERVER_PORT}" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sh", "/entrypoint.sh"]
