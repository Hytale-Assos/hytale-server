# Non-secret settings. Put passwords/tokens in Podman secrets instead
# (see README.md), this file is plain text.

SERVER_IP=0.0.0.0
SERVER_PORT=5520
TZ=Europe/Paris

# Logs go to journald: plain text reads better there
NO_COLOR=TRUE
PROD=TRUE
DEBUG=FALSE

# JVM heap = 75% of the container memory limit (PodmanArgs=--memory)
JAVA_ARGS=-XX:MaxRAMPercentage=75.0
# Faster startup after the first run (class-data archive in the volume)
HYTALE_CACHE=TRUE

# World backups, inside the data volume (Server/backups)
HYTALE_BACKUP_DIR=./backups
HYTALE_BACKUP_FREQUENCY=30
HYTALE_BACKUP_MAX_COUNT=48

# Server settings (applied to Server/config.json on every start)
#HYTALE_SERVER_NAME=Hytale Server
#HYTALE_MOTD=
#HYTALE_MAX_PLAYERS=100
#HYTALE_GAMEMODE=Adventure
